# Template env produksi. Salin ke .env.prod (JANGAN di-commit; sudah di-gitignore) lalu isi.
# Dipakai: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Domain publik tanpa skema; Caddy menerbitkan sertifikat HTTPS untuk domain ini.
# DNS A/AAAA domain harus sudah menunjuk ke VPS sebelum stack dijalankan.
SITE_ADDRESS=linkforge.deaprima.my.id
ACME_EMAIL=you@example.com

# Database (dibuat otomatis saat volume pertama kali dibuat; mengganti password nanti tidak mengubah volume lama)
DB_USER=linkforge
DB_NAME=linkforge
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h

# Email reset password. WAJIB di produksi: tanpa SMTP_HOST, isi email (termasuk tautan reset) hanya dicetak ke log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinkForge <no-reply@linkforge.deaprima.my.id>

# Google sign-in opsional: kosongkan keduanya untuk menonaktifkan
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alert lewat email memakai SMTP_* di atas. Kosongkan ALERT_EMAIL_TO untuk tanpa notifikasi
# (alert tetap terlihat di UI Prometheus dan Alertmanager).
ALERT_EMAIL_TO=

# Monitoring (hanya bind ke 127.0.0.1)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Tag image (mis. git sha) supaya rollback bisa memilih versi sebelumnya
TAG=latest
