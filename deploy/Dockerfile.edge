# Edge: Caddy (TLS otomatis + reverse proxy) yang sekaligus membawa build web statis.
# Konteks build = root repo, karena build web membaca api/openapi.yml:
#   docker build -f deploy/Dockerfile.edge -t linkforge/edge .
# syntax=docker/dockerfile:1

FROM node:22-alpine AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Halaman docs dibangun dari spec ini (vite plugin membaca ../api/openapi.yml)
COPY api/openapi.yml /app/api/openapi.yml
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /app/web/dist /srv/web
