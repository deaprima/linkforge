# DATABASE CONFIG
DB_USER=linkforge_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_NAME=linkforge
DB_PORT=5432

# REDIS CONFIG
REDIS_PORT=6379

# KAFKA CONFIG
KAFKA_PORT=9092
# Dipakai Link (producer) & Analytics (consumer) yang jalan di host; pisahkan dengan koma untuk >1 broker
KAFKA_BROKERS=localhost:9092

# SWAGGER CONFIG
SWAGGER_PORT=8090

# AUTH SERVICE CONFIG
AUTH_PORT=50051
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h

# OAUTH GOOGLE
# Client ID dipakai Auth (verifikasi id_token) dan Gateway (redirect flow).
# Client secret hanya dipakai Gateway. Kosongkan secret untuk menonaktifkan endpoint OAuth.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# PASSWORD RESET (Auth Service)
# Link reset di email mengarah ke FRONTEND_URL. Tanpa SMTP_HOST, email hanya dicetak ke log Auth Service
# (cukup untuk development; produksi WAJIB mengisi SMTP). Port 465 = TLS langsung, selain itu STARTTLS.
PASSWORD_RESET_TTL=1h
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinkForge <no-reply@linkforge.local>

# LINK SERVICE CONFIG
LINK_PORT=50052

# ANALYTICS SERVICE CONFIG
ANALYTICS_PORT=50053
# Opsional: path ke GeoLite2-Country.mmdb (gratis dari maxmind.com). Kosong = country "ZZ" (unknown)
GEOIP_DB_PATH=
# Opsional, default "analytics-service"
KAFKA_GROUP_ID=analytics-service

# GATEWAY SERVICE CONFIG
GATEWAY_PORT=8080
AUTH_GRPC_ADDR=localhost:50051
LINK_GRPC_ADDR=localhost:50052
ANALYTICS_GRPC_ADDR=localhost:50053
REDIS_ADDR=localhost:6379
# Opsional (nilai default di bawah)
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
GRPC_TIMEOUT=5s
# false hanya untuk dev via http di browser yang menolak Secure cookie
COOKIE_SECURE=true
# Brute-force protection POST /:alias/verify (opsional, nilai default di bawah).
# Di belakang reverse proxy, TRUSTED_PROXIES WAJIB diisi — tanpa itu semua user terlihat
# dengan IP proxy dan saling berbagi kuota.
VERIFY_LIMIT_PER_ALIAS=5
VERIFY_LIMIT_PER_IP=20
VERIFY_LIMIT_WINDOW=15m
# Lupa password (per IP): permintaan email reset dan percobaan reset. Fail-closed seperti verify.
FORGOT_LIMIT_PER_IP=5
FORGOT_LIMIT_WINDOW=1h
RESET_LIMIT_PER_IP=20
RESET_LIMIT_WINDOW=15m

# Rate limit umum Gateway: auth publik & redirect per IP, endpoint terautentikasi per user
AUTH_LIMIT_PER_IP=20
AUTH_LIMIT_WINDOW=15m
PUBLIC_LIMIT_PER_IP=300
PUBLIC_LIMIT_WINDOW=1m
USER_LIMIT_PER_USER=120
USER_LIMIT_WINDOW=1m

# OBSERVABILITY
# Listener internal /metrics + /healthz per service. Kosongkan nilainya untuk menonaktifkan.
# JANGAN diekspos ke internet (blokir di firewall / Nginx).
GATEWAY_METRICS_ADDR=:9100
AUTH_METRICS_ADDR=:9101
LINK_METRICS_ADDR=:9102
ANALYTICS_METRICS_ADDR=:9103
# Structured logging: LOG_FORMAT=json|text (default json), LOG_LEVEL=debug|info|warn|error (default info)
LOG_FORMAT=json
LOG_LEVEL=info
# Prometheus & Grafana (docker compose); UI hanya dibind ke 127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
