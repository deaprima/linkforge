# DATABASE CONFIG
DB_USER=linkforge_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_NAME=linkforge
DB_PORT=5432

# REDIS CONFIG
REDIS_PORT=6379

# KAFKA CONFIG
KAFKA_PORT=9092

# SWAGGER CONFIG
SWAGGER_PORT=8090

# AUTH SERVICE CONFIG
AUTH_PORT=50051
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h

# OAUTH GOOGLE
# Client ID dipakai Auth (verifikasi id_token) dan Gateway (redirect flow).
# Client secret hanya dipakai Gateway. Kosongkan secret untuk menonaktifkan endpoint OAuth.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# LINK SERVICE CONFIG
LINK_PORT=50052

# GATEWAY SERVICE CONFIG
GATEWAY_PORT=8080
AUTH_GRPC_ADDR=localhost:50051
LINK_GRPC_ADDR=localhost:50052
REDIS_ADDR=localhost:6379
# Opsional (nilai default di bawah)
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
GRPC_TIMEOUT=5s
# false hanya untuk dev via http di browser yang menolak Secure cookie
COOKIE_SECURE=true
